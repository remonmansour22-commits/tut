	},
	{
		Id = "SentinelStone",
		Name = "Sentinel Stone",
		Position = Vector3.new(60, 41, 88),
		Radius = 12,
		Xp = 25,
		Lore = "A weathered watcher, carved long before the last migration route faded.",
	},
	{
		Id = "TailSpire",
		Name = "The Tail Spire",
		Position = Vector3.new(18, 60, -166),
