<Item class="ModuleScript" referent="RBX8">
<Properties>
<string name="Name">Config</string>
<ProtectedString name="Source">--!strict
-- Path: ReplicatedStorage/BeastboundShared/Config
-- Global tuning constants. Change values here, not inside systems.

local Config = {
	-- Data / persistence
	DataStoreName = "Beastbound_PlayerData_v1",
	AutosaveIntervalSeconds = 60,
	MaxSaveRetries = 3,

	-- Progression
	LevelXpThresholds = { 0, 60, 140, 260, 420, 640, 920, 1270, 1700, 2220, 2850 }, -- index = level 1..11
	XpRewards = {
		Gather = 3,
		Contribute = 6,
		Build = 30,
		Discover = 25,
		ProjectCompleteBonus = 60,
	},

	-- Gathering
	NodeRespawnSeconds = 14,
	MaxGatherDistance = 14, -- sanity check beyond ProximityPrompt distance
	RareDoubleChance = 0.12,

	-- Building
	BuildRateLimitSeconds = 2,
	MaxRotationSteps = 4, -- rotation validated server-side

	-- Journey (community "migration momentum")
	JourneyMomentumPerMinute = 1.5,
	JourneyMomentumPerDiscover = 12,
	JourneyMomentumPerBuild = 8,
	JourneyMomentumPerProject = 120,

	-- Creature bond
	BondPerContribution = 2,
	BondPerBuild = 3,
	BondPerDiscover = 4,
	BondMaxLevel = 8,

	-- Community project
	HeartrootGlowseedsNeeded = 40,
	ContributeChunk = 5, -- per interaction, clamped to what the player holds

	WorldSeedSafe = true, -- reserved for future procedural variation
}

return Config
</ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX9">
<Properties>
<string name="Name">Net</string>
<ProtectedString name="Source">-- Path: ReplicatedStorage/BeastboundShared/Net
-- Single source of truth for remote objects.
-- Server: creates missing remotes on demand. Client: waits for them.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NET_FOLDER_NAME = "BeastboundRemotes"

local Net = {}

local function getFolder()
	local folder = ReplicatedStorage:FindFirstChild(NET_FOLDER_NAME)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = NET_FOLDER_NAME
		folder.Parent = ReplicatedStorage
	end
	return folder
end

local function createRemoteClass(name: string): string
	if name:sub(-2) == "Fn" then
		return "RemoteFunction"
	end
	return "RemoteEvent"
end

function Net.get(name: string): any
	local folder = getFolder()
	local remote = folder:FindFirstChild(name)
	if remote then
		return remote
	end

	local isServer = game:GetService("RunService"):IsServer()
	if isServer then
		remote = Instance.new(createRemoteClass(name))
		remote.Name = name
		remote.Parent = folder
		return remote
	end

	return folder:WaitForChild(name)
end

return Net
</ProtectedString>
</Properties>
</Item>
